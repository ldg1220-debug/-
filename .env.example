# edgeX API
EDGEX_API_URL=https://testnet-api.edgex.exchange
EDGEX_WS_URL=wss://testnet-ws.edgex.exchange
EDGEX_ACCOUNT_ID=your_edgex_account_id

# Wallet
PRIVATE_KEY=0xyour_private_key_here
WALLET_ADDRESS=0xyour_wallet_address

# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_TESTNET=true

# Trading symbol
SYMBOL=BTC-USDC

# Engine A config
ENGINE_A_ALLOCATION=0.25
BOX_LOOKBACK=50
VOLUME_SPIKE_MULTIPLIER=3.0

# Backtest fees (maker=박스 리밋 주문, taker=돌파/스탑 마켓 주문)
MAKER_FEE_PCT=0.0002
TAKER_FEE_PCT=0.0005

# Engine B config
ENGINE_B_ALLOCATION=0.75

# Sweeper config
SWEEP_THRESHOLD=100.0
SWEEP_INTERVAL_SECONDS=3600

# Monitor config
ATR_PERIOD=14
DRIFT_MULTIPLIER=2.0

# Risk Manager
TOTAL_CAPITAL=10000.0
MAX_DAILY_LOSS_PCT=0.05
MAX_POSITION_SIZE_PCT=0.20

# Optimizer (GA 자가 학습)
GA_POPULATION=24
GA_GENERATIONS=15
GA_ELITISM=2
GA_MUTATION_RATE=0.10
DRIFT_Z_THRESHOLD=2.0
FITNESS_DRAWDOWN_PENALTY=2.0
OPTIMIZER_CHECK_INTERVAL=3600
OPTIMIZER_ENV_PATH=.env
OPTIMIZER_CONFIG_PATH=config/strategy_config.json

# Alerts (텔레그램)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Blockchain RPC
ARB_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# State DB
STATE_DB_PATH=./data/trading_state.db
