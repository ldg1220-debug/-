# edgeX API
EDGEX_API_URL=https://testnet-api.edgex.exchange
EDGEX_WS_URL=wss://testnet-ws.edgex.exchange
EDGEX_ACCOUNT_ID=your_edgex_account_id

# Wallet
PRIVATE_KEY=0xyour_private_key_here
WALLET_ADDRESS=0xyour_wallet_address

# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_TESTNET=true

# Trading symbol
SYMBOL=BTC-USDC

# Engine A config
ENGINE_A_ALLOCATION=0.25
BOX_LOOKBACK=50
VOLUME_SPIKE_MULTIPLIER=3.0

# Engine B config
ENGINE_B_ALLOCATION=0.75

# Sweeper config
SWEEP_THRESHOLD=100.0
SWEEP_INTERVAL_SECONDS=3600

# Monitor config
ATR_PERIOD=14
DRIFT_MULTIPLIER=2.0
